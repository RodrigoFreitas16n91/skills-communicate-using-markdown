# Variáveis de ambiente — Exemplo de configuração
# ====================================================
# ATENÇÃO: Este arquivo serve como MODELO.
#          NUNCA commite o arquivo .env real com credenciais!
#          Copie este arquivo para .env e preencha os valores.
# ====================================================

# -------------------------------------------------------
# CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# -------------------------------------------------------
AMBIENTE=desenvolvimento
LOG_NIVEL=DEBUG
DEBUG_ATIVO=true
FUSO_HORARIO=America/Sao_Paulo
QUANTIDADE_WORKERS=2

# -------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# -------------------------------------------------------
POSTGRES_SENHA=troque_por_senha_segura
DATABASE_URL=postgresql://usuario_pg:troque_por_senha_segura@postgres:5432/integracao_db

# -------------------------------------------------------
# CACHE (Redis)
# -------------------------------------------------------
REDIS_SENHA=troque_por_senha_segura
REDIS_URL=redis://:troque_por_senha_segura@redis:6379/0

# -------------------------------------------------------
# FILA DE MENSAGENS (RabbitMQ)
# -------------------------------------------------------
RABBITMQ_SENHA=troque_por_senha_segura
RABBITMQ_URL=amqp://usuario_rmq:troque_por_senha_segura@rabbitmq:5672/

# -------------------------------------------------------
# MCP (Model Context Protocol)
# -------------------------------------------------------
MCP_SERVIDOR_URL=http://mcp-servidor:8000
MCP_TOKEN_ACESSO=troque_por_token_seguro

# -------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL (LLM)
# -------------------------------------------------------
LLM_PROVEDOR=openai
LLM_MODELO=gpt-4o-mini
LLM_CHAVE_API=CHAVE_EXEMPLO

# -------------------------------------------------------
# INTEGRAÇÃO TOTVS PROTHEUS
# -------------------------------------------------------
TOTVS_URL_BASE=https://seu-servidor-totvs:8080
TOTVS_USUARIO=usuario_integracao
TOTVS_SENHA=troque_por_senha_segura
TOTVS_EMPRESA=01
TOTVS_FILIAL=0101
TOTVS_TOKEN_ACESSO=
TOTVS_TIMEOUT_SEGUNDOS=30

# -------------------------------------------------------
# INTEGRAÇÃO SAP ERP
# -------------------------------------------------------
SAP_URL_BASE=https://seu-servidor-sap
SAP_USUARIO=svc_integracao
SAP_SENHA=troque_por_senha_segura
SAP_CLIENTE=100
SAP_MANDANTE=800
SAP_TOKEN_ACESSO=
SAP_TIMEOUT_SEGUNDOS=60
SAP_VERSAO_ODATA=v4

# -------------------------------------------------------
# INTEGRAÇÃO ORACLE ERP CLOUD
# -------------------------------------------------------
ORACLE_URL_BASE=https://seu-tenant.oraclecloud.com
ORACLE_CLIENTE_ID=seu_client_id
ORACLE_CLIENTE_SEGREDO=seu_client_secret
ORACLE_URL_IDCS=https://idcs-xxx.identity.oraclecloud.com
ORACLE_TOKEN_ACESSO=
ORACLE_TIMEOUT_SEGUNDOS=45

# -------------------------------------------------------
# OBSERVABILIDADE
# -------------------------------------------------------
ELASTIC_SENHA=troque_por_senha_segura
KIBANA_SENHA=troque_por_senha_segura
GRAFANA_SENHA=troque_por_senha_segura

# -------------------------------------------------------
# NOTIFICAÇÕES
# -------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
SLACK_CANAL_ALERTAS=#alertas-integracao
ALERTA_EMAIL_DESTINO=ops@empresa.com

# -------------------------------------------------------
# AGENTES
# -------------------------------------------------------
SYNC_INTERVALO_MINUTOS=5
SYNC_TAMANHO_LOTE=100
SYNC_TENTATIVAS_MAXIMAS=3
ALERTA_LIMIAR_ERROS=10
